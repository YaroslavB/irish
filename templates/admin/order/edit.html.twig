{% extends 'admin/layout/layout_main.html.twig' %}

{% block title_detailed %}Edit Order{% endblock %}

{% block body %}
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            {% include 'admin/_embed/_card/_breadcrumbs.html.twig' with{
                'sectionTitle':'Orders',
                'actionUrl': path('admin_order_list'),
                'addActionUrl': path('admin_order_add'),
                'entity': order
            } %}
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            <div class="form-group row">
                <div class="col-md-1">
                    id:
                </div>
                <div class="col-md-11">
                    {{ order.id }}
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    created at:
                </div>
                <div class="col-md-11">
                    {{ order.createdAt|date('H:i | j F Y') }}
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    updated at:
                </div>
                <div class="col-md-11">
                    {{ order.updatedAt|date('H:i | j F Y') }}
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.owner) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.owner) }}
                    <div class="form_errors">
                        {{ form_errors(form.owner) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.status) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.status) }}
                    <div class="form_errors">
                        {{ form_errors(form.status) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1"></div>
                <div class="col-md-11 pl-5">
                    {{ form_widget(form.isDeleted) }}
                    {{ form_label(form.isDeleted) }}
                    <div class="form-error">
                        {{ form_errors(form.isDeleted) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    Products
                </div>
                <div class="col-md-11">
                    {% for orderProduct in order.orderProducts %}
                        {% set product = orderProduct.product %}
                        <div> id:{{ product.id }} - {{ product.title }} - ${{ orderProduct.pricePerOne }} </div>
                    {% endfor %}
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    Total price:
                </div>
                <div class="col-md-11">
                    {{ order.totalPrice|format_currency('USD') }}
                </div>
            </div>


            <hr/>
            {% include 'admin/_embed/_card/_form_buttons.html.twig' with{
                'entity':order,
                'catalog_route': path('admin_order_list')
            } %}
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>

    {% if order and order.id %}
        {% include 'admin/_embed/_utils/_modal.html.twig' with{
            'modalId': 'approveDeleteModal',
            'modalTitle': 'Delete category?',
            'modaslText':   'Delete category',
            'actionUrl': path('admin_order_delete', {'id': order.id}),
            'modalBtnText':'Delete order'} %}
    {% endif %}
{% endblock %}
