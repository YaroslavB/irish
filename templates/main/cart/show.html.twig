{% extends 'main/base.html.twig' %}

{% block title %}Your cart - RankedChoice{% endblock %}
{% block page_keywords %}Jeans, Ranked Choice Homepage, Jackets{% endblock %}
{% block page_description %}User cart page of RankedChoice shop!{% endblock %}

{% block body %}
    <div class="text-center">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 mb-2 text-center">
                    <div class="page-details mt-4">
                        <h1 class="h4 mb-3 font-weight-normal title-gradient-1">Your cart</h1>
                        <div class="row">
                            <div class="col-lg-12 order-block">
                                <div class="order-content">
                                    {% if cart %}
                                        <table class="table table-cart table-mobile main-cart-show">
                                            <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th>Price</th>
                                                <th>Quantity</th>
                                                <th>Total</th>
                                                <th></th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% for cartProduct in cart.product %}
                                                {% set product = cartProduct.product %}
                                                <tr>
                                                    <td class="product-col">
                                                        <div class="text-center">
                                                            <figure>
                                                                <a href="{{ path('main_product_show', {'uuid': product.uuid}) }}"
                                                                   target="_blank">
                                                                    <img
                                                                            src=""
                                                                            alt="{{ product.title }}"
                                                                    />
                                                                </a>

                                                            </figure>

                                                        </div>
                                                    </td>
                                                    <td class="price-col">
                                                        ${{ product.price }}
                                                    </td>
                                                    <td class="quantity-col">
                                                        {{ product.quantity }}
                                                    </td>

                                                </tr>

                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    {% else %}
                                        <div class="alert alert-info" role="alert">
                                            Your cart is empty!
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}