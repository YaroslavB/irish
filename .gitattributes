# Auto detect text files and perform LF normalization
* text=auto

# PHP files
*.php text eol=lf

# Symfony/Config files
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.twig text eol=lf

# Shell scripts
*.sh text eol=lf
bin/console text eol=lf
bin/phpunit text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf
*.ini text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Exclude from export
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
docker/ export-ignore
tests/ export-ignore
phpunit.xml.dist export-ignore
psalm.xml export-ignore
rector.php export-ignore
*.md export-ignore

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

